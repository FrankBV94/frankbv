---
import Section from "../Section.astro";

const lang = Astro.currentLocale;
const translation =
  lang === "en"
    ? (await import("@cvEn")).default
    : (await import("@cvEs")).default;

const { education } = translation;
---

<Section title={lang === "en" ? "Education" : "Educación"} />
<ul>
  {
    education.map(({ institution, startDate, endDate, area, url }) => {
      const startYear = new Date(startDate).getFullYear();
      const current = lang === "en" ? "Current" : "Actual";
      const endYear =
        endDate != null ? new Date(endDate).getFullYear() : current;
      const years = `${startYear} - ${endYear}`;

      return (
        <li>
          <article>
            <header>
              <div>
                <h3>
                  <a
                    href={url}
                    title={`Ver ${institution}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {institution}
                  </a>
                </h3>
              </div>

              <time>{years}</time>
            </header>

            <footer>
              <p>{area}</p>
            </footer>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article a:hover {
    text-decoration: underline;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    min-width: 102px;
    text-align: right;
  }
</style>
