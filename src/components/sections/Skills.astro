---
import Section from "../Section.astro";

const lang = Astro.currentLocale;
const translation =
  lang === "en"
    ? (await import("@cvEn")).default
    : (await import("@cvEs")).default;

const { skills } = translation;
---

<Section title={lang === "en" ? "Skills" : "Habilidades"} />
<ul>
  {
    skills.map(({ name }) => {
      return (
        <li>
          <span class="badge">{name}</span>
        </li>
      );
    })
  }
</ul>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  footer {
    display: flex;
    gap: 0.5rem;
    margin-top: 8px;
  }
</style>
