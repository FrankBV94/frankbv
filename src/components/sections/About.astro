---
import Section from "../Section.astro";
const lang = Astro.currentLocale;
const translation =
  lang === "en"
    ? (await import("@cvEn")).default
    : (await import("@cvEs")).default;

const { summary } = translation.basics;
---

<Section title={lang === "en" ? "About" : "Perfil profesional"}>
  <p>{summary.first}</p>
  <p>{summary.second}</p>
</Section>

<style>
  p:first-of-type {
    margin-bottom: 1rem;
  }
</style>
